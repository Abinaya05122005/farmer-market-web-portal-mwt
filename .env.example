# ===================================================================
# Farmer Market Web Portal - Secure Environment Configuration Example
# ===================================================================

# 1. Google Gemini API Key (Recommended)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. OpenAI API Key (Alternative)
OPENAI_API_KEY=your_openai_api_key_here

# 3. Groq Cloud API Key (Alternative)
GROQ_API_KEY=your_groq_api_key_here

# Backend Server Port
PORT=3001
